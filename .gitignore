# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing & linting caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local project data & runtime artifacts (keep directory structure via .gitkeep if needed)
data/raw/*
data/parquet/*
data/db/*.sqlite
data/db/*.sqlite-*
data/db/backups/*
data/editor/*
data_demo/
!data/**/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/

# dbt artifacts & DuckDB runtime files
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/*.duckdb
dbt/*.duckdb.wal
.duckdb_extensions/
*.duckdb
*.duckdb.wal

# Spreadsheet lock / temporary files
~$*.xlsx
.~lock.*.xlsx#
.~lock.*.ods#

# OS & editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
